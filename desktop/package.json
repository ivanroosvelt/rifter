{
  "name": "rifter",
  "version": "0.0.0",
  "description": "Rifter",
  "author": "Ivan Roosvelt",
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.ivanroosvelt.rifter",
    "productName": "Rifter",
    "files": ["main.js"],
    "afterPack": "adhoc.js",
    "extraResources": [{ "from": "resources", "to": "." }],
    "mac": { "target": ["dmg"], "category": "public.app-category.music" },
    "linux": { "target": ["AppImage"], "category": "Audio" },
    "win": { "target": ["nsis"] }
  }
}
